    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>PclDl.Bootstrap</AssemblyName>
    <RootNamespace>PclDl.Bootstrap</RootNamespace>
